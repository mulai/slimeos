<resources>
    <!-- Same dark shell as the Membrane kiosk (lockscreen/index.html, shell colour),
         so nothing flashes white between the splash and the first frame. -->
    <style name="Theme.SlimeOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/slime_shell</item>
        <item name="android:colorBackground">@color/slime_shell</item>
        <item name="android:colorAccent">@color/slime_teal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The session: FreeRDP's theme with see-through system bars, set here rather
         than by SessionActivity's Window.setStatusBarColor/setNavigationBarColor
         (deprecated, no-ops from Android 15; Play flags them; see
         freerdp-patches/session-edge-to-edge.patch). -->
    <style name="Theme.SlimeOS.Session" parent="@style/Theme.Main.Session">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
