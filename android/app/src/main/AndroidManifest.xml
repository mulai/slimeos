<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WireGuard tunnel -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="com.freerdp.freerdpcore.application.GlobalApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.SlimeOS"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:theme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sessions start only from this app (#47): our subclass, which
             takes the password as an extra (see SlimeSessionActivity.kt). -->
        <activity
            android:name=".SlimeSessionActivity"
            android:exported="false"
            android:theme="@style/Theme.Main.Session"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout|navigation"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="com.freerdp.session"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true" />

        <!-- freeRDPCore exports these, and SessionActivity takes any
             freerdp:// link (BROWSABLE) and maps its query parameters to
             FreeRDP flags, so another app or a web page could start a
             session with drive redirection to a server of its choosing
             (#47). Nothing outside this app may start them. -->
        <activity
            android:name="com.freerdp.freerdpcore.presentation.SessionActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity
            android:name="com.freerdp.freerdpcore.presentation.ShortcutsActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity-alias
            android:name="com.freerdp.freerdpcore.presentation.CreateShortcuts"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity
            android:name="com.freerdp.freerdpcore.presentation.ApplicationSettingsActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity
            android:name="com.freerdp.freerdpcore.presentation.AboutActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />
        <activity
            android:name="com.freerdp.freerdpcore.presentation.HelpActivity"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />

    </application>

</manifest>
