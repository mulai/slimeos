+	// The last session's picture, if it was of this server and recent; only once.
+	private Bitmap takeLastFrame()
+	{
+		synchronized (SessionActivity.class)
+		{
+			Bitmap old = null;
+			String key = frameKey();
+			if (lastFrame != null && key != null && key.equals(lastFrameKey) &&
+			    android.os.SystemClock.elapsedRealtime() - lastFrameAt < LAST_FRAME_MAX_AGE_MS)
+				old = lastFrame;
+			lastFrame = null;
+			lastFrameKey = null;
+			return old;
+		}
+	}
