+	// True if the region of `b` looks plain black, sampled on a grid.
+	private static boolean looksBlack(Bitmap b, Rect r)
+	{
+		final int steps = 24;
+		for (int i = 0; i < steps; i++)
+		{
+			int py = r.top + (r.height() - 1) * i / (steps - 1);
+			for (int j = 0; j < steps; j++)
+			{
+				int px = r.left + (r.width() - 1) * j / (steps - 1);
+				if ((b.getPixel(px, py) & 0xF0F0F0) != 0)
+					return false;
+			}
+		}
+		return true;
 	}
 
