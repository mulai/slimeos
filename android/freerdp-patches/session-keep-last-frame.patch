+	// On screen from the start of a connect, not only once it's up: on a weak
+	// connection the handshakes alone take seconds, black ones until now.
+	private void showLastFrame()
+	{
+		Bitmap old = takeLastFrame();
+		if (old == null)
+			return;
+		bitmap = old;
+		hasPicture = true;
+		showingOldFrame = true;
+		holdingSince = android.os.SystemClock.elapsedRealtime();
+		Log.i(TAG, "Showing the last session's picture while connecting");
+		session.setSurface(new BitmapDrawable(getResources(), bitmap));
+		sessionView.onSurfaceChange(session);
+	}
