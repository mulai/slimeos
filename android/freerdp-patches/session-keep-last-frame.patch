+	// A bitmap for a (re)sized session that starts with the picture already on screen,
+	// scaled if the size changed.
+	private Bitmap bitmapKeepingPicture(int width, int height, int bpp)
+	{
+		Config config = bpp > 16 ? Config.ARGB_8888 : Config.RGB_565;
+		Bitmap old = bitmap;
+		if (old == null || !hasPicture)
+		{
+			showingOldFrame = false;
+			holdingSince = 0;
+			return Bitmap.createBitmap(width, height, config);
+		}
+		Log.i(TAG, "Graphics reset to " + width + "x" + height + ": keeping the picture on screen");
+		showingOldFrame = true;
+		if (holdingSince == 0)
+		{
+			holdingSince = android.os.SystemClock.elapsedRealtime();
+			heldRegion = null;
+			heldUpdates = 0;
+		}
+		if (old.isMutable() && old.getWidth() == width && old.getHeight() == height &&
+		    old.getConfig() == config)
+			return old;
+		Bitmap fresh = Bitmap.createBitmap(width, height, config);
+		new Canvas(fresh).drawBitmap(old, null, new Rect(0, 0, width, height),
+		                             new Paint(Paint.FILTER_BITMAP_FLAG));
+		return fresh;
+	}
