diff --git a/channels/rdpgfx/client/rdpgfx_main.c b/channels/rdpgfx/client/rdpgfx_main.c
index 3dba687..cbc2926 100644
--- a/channels/rdpgfx/client/rdpgfx_main.c
+++ b/channels/rdpgfx/client/rdpgfx_main.c
@@ -38,6 +38,7 @@
 
 #include <freerdp/addin.h>
 #include <freerdp/channels/log.h>
+#include <freerdp/codec/h264.h>
 
 #include "rdpgfx_common.h"
 #include "rdpgfx_codec.h"
@@ -330,6 +331,31 @@ static UINT rdpgfx_send_supported_caps(GENERIC_CHANNEL_CALLBACK* callback)
 
 	RDPGFX_CAPS_ADVERTISE_PDU pdu = { .capsSetCount = 0, .capsSets = capsSets };
 
+#ifdef WITH_GFX_H264
+	/*
+	 * Only offer AVC if a decoder can actually be created. With a runtime-loaded
+	 * decoder (OpenH264 not downloaded, or turned off by the user) the server
+	 * would otherwise send H.264 that nothing can decode: a black screen.
+	 */
+	rdpSettings* settings = gfx->rdpcontext->settings;
+	if (freerdp_settings_get_bool(settings, FreeRDP_GfxH264) ||
+	    freerdp_settings_get_bool(settings, FreeRDP_GfxAVC444))
+	{
+		H264_CONTEXT* probe = h264_context_new(FALSE);
+		if (probe)
+			h264_context_free(probe);
+		else
+		{
+			WLog_Print(gfx->base.log, WLOG_WARN,
+			           "No H.264 decoder available, not offering AVC to the server");
+			if (!freerdp_settings_set_bool(settings, FreeRDP_GfxH264, FALSE) ||
+			    !freerdp_settings_set_bool(settings, FreeRDP_GfxAVC444, FALSE) ||
+			    !freerdp_settings_set_bool(settings, FreeRDP_GfxAVC444v2, FALSE))
+				return ERROR_INTERNAL_ERROR;
+		}
+	}
+#endif
+
 	if (!rdpgfx_is_capability_filtered(gfx, RDPGFX_CAPVERSION_8))
 	{
 		RDPGFX_CAPSET* capsSet = nextCapset(&pdu, ARRAYSIZE(capsSets));
