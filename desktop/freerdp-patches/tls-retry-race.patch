diff --git a/libfreerdp/crypto/tls.c b/libfreerdp/crypto/tls.c
index 525880b..fe6a0c7 100644
--- a/libfreerdp/crypto/tls.c
+++ b/libfreerdp/crypto/tls.c
@@ -205,8 +205,10 @@ static int bio_rdp_tls_write(BIO* bio, const char* buf, int size)
 	}
 #endif
 
+	/* Slime OS: no BIO_clear_retry_flags() here (cfb77bd0). It ran outside the lock, so a
+	 * write on one thread could clear the retry flag a read on another had just set, and
+	 * the reader then took EAGAIN for a broken connection. */
 	BIO_clear_flags(bio, BIO_FLAGS_WRITE | BIO_FLAGS_READ | BIO_FLAGS_IO_SPECIAL);
-	BIO_clear_retry_flags(bio);
 	EnterCriticalSection(&tls->lock);
 	status = SSL_write(tls->ssl, buf, size);
 	error = SSL_get_error(tls->ssl, status);
@@ -275,8 +277,10 @@ static int bio_rdp_tls_read(BIO* bio, char* buf, int size)
 	}
 #endif
 
+	/* Slime OS: no BIO_clear_retry_flags() here (cfb77bd0). It ran outside the lock, so a
+	 * write on one thread could clear the retry flag a read on another had just set, and
+	 * the reader then took EAGAIN for a broken connection. */
 	BIO_clear_flags(bio, BIO_FLAGS_WRITE | BIO_FLAGS_READ | BIO_FLAGS_IO_SPECIAL);
-	BIO_clear_retry_flags(bio);
 	EnterCriticalSection(&tls->lock);
 	status = SSL_read(tls->ssl, buf, size);
 	error = SSL_get_error(tls->ssl, status);
