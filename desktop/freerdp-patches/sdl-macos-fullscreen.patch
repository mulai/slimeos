+/* On macOS a full screen window leaves its Space with an animation, and a window that asks for
+ * full screen before that ends never gets one (its request stays pending). Let the dummy leave
+ * first, so the session window created next gets its Space. */
+static void destroyDummy(SDL_Window* window)
+{
+	if (!window)
+		return;
+#if defined(__APPLE__)
+	std::ignore = SDL_SetWindowFullscreen(window, false);
+	std::ignore = SDL_SyncWindow(window);
+#endif
+	SDL_DestroyWindow(window);
+}
