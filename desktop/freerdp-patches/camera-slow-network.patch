+/* QP range of the camera's H.264 stream: 26 is upstream's fixed value (best quality) */
+#define ECAM_H264_QP_BEST 26u
+#define ECAM_H264_QP_WORST 42u
+/* Average wait (ms) above which frames get smaller, and below which they get better again */
+#define ECAM_SAMPLE_WAIT_SLOW_MS 300u
+#define ECAM_SAMPLE_WAIT_FAST_MS 120u
+/* At most one step to smaller frames per this many ms (four times as long back up) */
+#define ECAM_QP_STEP_INTERVAL_MS 1000u
+/* Highest camera resolution offered to Windows, in lines (SLIMEOS_CAMERA_MAX_HEIGHT overrides,
+ * 0 = no cap): Windows takes the largest, and 1080p frames are too big for a hotel uplink. */
+#define ECAM_DEFAULT_MAX_HEIGHT 720u
+
 /* Internal callback result asking a request-driven HAL to release the capture device. */
 #define ECAM_SAMPLE_CAPTURE_DRAINED 0x00010000u
 
