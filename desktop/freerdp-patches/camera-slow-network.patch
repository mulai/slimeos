+
+/* Slime OS: called with stream->lock held, on each Sample Request */
+static void ecam_dev_adapt_quality(CameraDeviceStream* stream, UINT64 now)
+{
+	if (stream->qp == 0)
+		stream->qp = ECAM_H264_QP_BEST;
+
+	if (stream->lastSampleResponseTime == 0)
+		return;
+
+	UINT64 wait = now - stream->lastSampleResponseTime;
+	stream->lastSampleResponseTime = 0;
+	if (wait > 60000)
+		wait = 60000;
+
+	/* average over about four frames: one big frame alone doesn't change the quality */
+	stream->sampleWaitAvgMs = (UINT32)((3ull * stream->sampleWaitAvgMs + wait) / 4ull);
+
+	/* A new QP makes OpenH264 start again with a key frame, so step rarely: down fast, back up
+	 * slowly. */
+	const UINT64 sinceChange = now - stream->lastQpChangeTime;
+	const UINT32 old = stream->qp;
+	if ((stream->sampleWaitAvgMs > ECAM_SAMPLE_WAIT_SLOW_MS) && (stream->qp < ECAM_H264_QP_WORST) &&
+	    (sinceChange >= ECAM_QP_STEP_INTERVAL_MS))
+	{
+		stream->qp += 4u;
+		if (stream->qp > ECAM_H264_QP_WORST)
+			stream->qp = ECAM_H264_QP_WORST;
+	}
+	else if ((stream->sampleWaitAvgMs < ECAM_SAMPLE_WAIT_FAST_MS) &&
+	         (stream->qp > ECAM_H264_QP_BEST) && (sinceChange >= 4ull * ECAM_QP_STEP_INTERVAL_MS))
+		stream->qp -= 2u;
+
+	if (stream->qp < ECAM_H264_QP_BEST)
+		stream->qp = ECAM_H264_QP_BEST;
+
+	if (stream->qp != old)
+	{
+		stream->lastQpChangeTime = now;
+		WLog_INFO(TAG, "Camera quality: QP %" PRIu32 " -> %" PRIu32 " (Windows waits %" PRIu32
+		          " ms for a frame)",
+		          old, stream->qp, stream->sampleWaitAvgMs);
+	}
 }
 
