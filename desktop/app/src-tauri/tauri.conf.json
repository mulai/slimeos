{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slime OS",
  "version": "0.1.0",
  "identifier": "com.slimeos.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Slime OS",
        "width": 960,
        "height": 700,
        "minWidth": 640,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#05080b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://(www\\.)?slimeos\\.com/"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Mulai Pte. Ltd.",
    "copyright": "© Mulai Pte. Ltd.",
    "category": "Productivity",
    "shortDescription": "Your Brain's desktop on this computer",
    "homepage": "https://www.slimeos.com",
    "externalBin": ["binaries/slimeos-desktop-core"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
