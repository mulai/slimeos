{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: run the core sidecar, open slimeos.com links, close itself.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/slimeos-desktop-core", "sidecar": true, "args": ["serve"] }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open"
  ]
}
