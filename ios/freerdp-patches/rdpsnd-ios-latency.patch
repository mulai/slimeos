 {
 	rdpsndIOSPlugin* p = THIS(device);
-	const BOOL ok = TPCircularBufferProduceBytes(&p->buffer, data, size);
+	int32_t queued = 0;
+	TPCircularBufferTail(&p->buffer, &queued);
+
+	/* Slime OS: report how long this chunk waits before it's heard (FreeRDP
+	 * passes it to the server in the wave confirm), and drop it rather than
+	 * queue past MAX_QUEUED_MS. Only the render thread consumes, so the old
+	 * end of the queue can't be trimmed from here. */
+	const UINT32 per_ms = p->bytes_per_ms ? p->bytes_per_ms : 1;
+	const UINT64 now = GetTickCount64();
+	if (p->stats_since == 0)
+		p->stats_since = now;
+	if ((UINT32)queued / per_ms > p->max_queued_ms)
+		p->max_queued_ms = (UINT32)queued / per_ms;
+	if (now - p->stats_since >= 2000)
+	{
+		WLog_INFO(SL_TAG, "2 s: %" PRIu32 " chunks played, %" PRIu32 " dropped, %" PRIu32
+		          " underruns, queue now %" PRIu32 " ms (max %" PRIu32 " ms), chunk %" PRIuz " ms",
+		          p->played, p->dropped, p->underruns, (UINT32)queued / per_ms, p->max_queued_ms,
+		          size / per_ms);
+		p->stats_since = now;
+		p->played = p->dropped = p->underruns = p->max_queued_ms = 0;
+	}
+	const size_t max_queued = MAX((size_t)per_ms * MAX_QUEUED_MS, 2 * size);
+	if (queued > 0 && (UINT32)queued + size > max_queued)
+	{
+		p->dropped++;
+		return (UINT32)queued / per_ms;
+	}
+	p->played++;
+
+	const BOOL ok = TPCircularBufferProduceBytes(&p->buffer, data, (int32_t)size);
 
 	if (!ok)
 		return 0;
 
 	rdpsnd_ios_start(device);
-	return 10; /* TODO: Get real latencry in [ms] */
+	return (UINT32)(((size_t)queued + size) / per_ms);
 }
 
